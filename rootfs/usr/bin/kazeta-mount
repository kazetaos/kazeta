#! /bin/bash

if [ $EUID -ne 0 ]; then
        echo "$(basename $0) must be run as root"
        exit 1
fi

if [ "$1" == "kzp" ]; then
	mountpath=$3
	if [ "$2" == "--unmount" ]; then
		umount "$mountpath"
	else
		umount "$mountpath" &> /dev/null
		rm -rf "$mountpath"
		mkdir -p "$mountpath"
		mount "$2" "$mountpath"
	fi

	exit 0
fi

if [ "$1" == "install" ]; then
	gamedir="$2"
	workdir="$3"
	targetdir="$4"
	runtime="$5"
	runtimedir="$6"

	umount "$targetdir" &> /dev/null
	umount "$runtimedir" &> /dev/null
	rm -rf "$workdir"
	rm -rf "$targetdir"
	rm -rf "$runtimedir"
	mkdir -p "$workdir"
	mkdir -p "$targetdir"
	mkdir -p "$runtimedir"

	mount "$runtime" "$runtimedir"
	mount -t overlay overlay -o metacopy=on,lowerdir="$runtimedir",upperdir="$gamedir",workdir="$workdir" "$targetdir"

	exit 0
fi

if [ "$1" == "--unmount" ]; then
	umount "$2"
	umount "$3"
else
	lowerdir="$1"
	upperdir="$2"
	workdir="$3"
	targetdir="$4"
	runtime="$5"
	runtimedir="$6"

	rm -rf "$workdir"
	rm -rf "$targetdir"
	rm -rf "$runtimedir"
	mkdir -p "$workdir"
	mkdir -p "$targetdir"
	mkdir -p "$runtimedir"

	mount "$runtime" "$runtimedir"

	# metacopy=on reduces the pressure vessel writes
	mount -t overlay overlay -o metacopy=on,lowerdir="$lowerdir:$runtimedir",upperdir="$upperdir",workdir="$workdir" "$targetdir"
fi
