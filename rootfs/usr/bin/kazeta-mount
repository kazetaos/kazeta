#! /bin/bash

if [ $EUID -ne 0 ]; then
        echo "$(basename $0) must be run as root"
        exit 1
fi

if [ "$1" == "cdemu" ]; then
	# mount/unmount a CDEmu virtual disc for games that need the original CD;
	# loading the image itself is done from the user session (the daemon is user D-Bus activated)
	action=$2
	device=$3
	srdev="/dev/sr$device"
	if [ "$action" == "mount" ] || [ "$action" == "unmount" ]; then
		# wait for the virtual drive node to appear
		for i in $(seq 1 60); do
			[ -b "$srdev" ] && break
			sleep 0.5
		done
		if [ "$action" == "unmount" ]; then
			umount "$srdev" &> /dev/null
			rmdir "/run/media/sr$device" 2> /dev/null
		elif [ -b "$srdev" ]; then
			# already mounted by the optical media automount, otherwise mount it ourselves
			if ! findmnt -rno SOURCE "$srdev" &> /dev/null; then
				mountpoint="/run/media/sr$device"
				mkdir -p "$mountpoint"
				mount "$srdev" "$mountpoint"
			fi
		fi
	fi
	exit 0
fi

if [ "$1" == "kzp" ]; then
	mountpath=$3
	if [ "$2" == "--unmount" ]; then
		umount "$mountpath"
	else
		umount "$mountpath" &> /dev/null
		rm -rf "$mountpath"
		mkdir -p "$mountpath"
		mount "$2" "$mountpath"
	fi

	exit 0
fi

if [ "$1" == "install" ]; then
	gamedir="$2"
	workdir="$3"
	targetdir="$4"
	runtime="$5"
	runtimedir="$6"

	umount "$targetdir" &> /dev/null
	umount "$runtimedir" &> /dev/null
	rm -rf "$workdir"
	rm -rf "$targetdir"
	rm -rf "$runtimedir"
	mkdir -p "$workdir"
	mkdir -p "$targetdir"
	mkdir -p "$runtimedir"

	mount "$runtime" "$runtimedir"
	mount -t overlay overlay -o metacopy=on,xino=off,lowerdir="$runtimedir",upperdir="$gamedir",workdir="$workdir" "$targetdir"

	exit 0
fi

if [ "$1" == "--unmount" ]; then
	umount "$2"
	umount "$3"
else
	lowerdir="$1"
	upperdir="$2"
	workdir="$3"
	targetdir="$4"
	runtime="$5"
	runtimedir="$6"

	rm -rf "$workdir"
	rm -rf "$targetdir"
	rm -rf "$runtimedir"
	mkdir -p "$workdir"
	mkdir -p "$targetdir"
	mkdir -p "$runtimedir"

	mount "$runtime" "$runtimedir"

	# metacopy=on reduces the pressure vessel writes
	# xino=off fixes 32-bit applications crashing
	mount -t overlay overlay -o metacopy=on,xino=off,lowerdir="$lowerdir:$runtimedir",upperdir="$upperdir",workdir="$workdir" "$targetdir"
fi
